@using FacebookPublisher.Web.Identity
@using FacebookPublisher.Web.Endpoints
@implements IDisposable
@inject CampaignEventBroker Broker
@inject FacebookPublisher.Application.Abstractions.ICampaignExecutionTracker Tracker

<div class="brand">
    <span class="brand-icon"><i class="bi bi-broadcast"></i></span>
    <div>
        <div class="brand-name">Group Publisher</div>
        <div class="brand-sub">Content distribution</div>
    </div>
</div>

<nav class="menu">
    <NavLink class="menu-link" href="" Match="NavLinkMatch.All"><i class="bi bi-speedometer2"></i> Dashboard</NavLink>
    <NavLink class="menu-link" href="groups"><i class="bi bi-people"></i> Facebook Groups</NavLink>
    <NavLink class="menu-link" href="content"><i class="bi bi-pencil-square"></i> Content Composer</NavLink>
    <NavLink class="menu-link" href="campaigns/new"><i class="bi bi-send"></i> Publishing Campaign</NavLink>
    <NavLink class="menu-link" href="monitor">
        <i class="bi bi-activity"></i> Execution Monitor
        @if (_running)
        {
            <span class="live-dot" title="One of your campaigns is running"></span>
        }
    </NavLink>
    <NavLink class="menu-link" href="reports"><i class="bi bi-file-earmark-bar-graph"></i> Reports</NavLink>
    <NavLink class="menu-link" href="settings"><i class="bi bi-gear"></i> Settings</NavLink>
    <AuthorizeView Roles="@FacebookPublisher.Application.Abstractions.AppRoles.Admin">
        <NavLink class="menu-link" href="admin/users"><i class="bi bi-person-gear"></i> User Management</NavLink>
    </AuthorizeView>
</nav>

<AuthorizeView>
    <div class="user-box">
        <div class="user-avatar"><i class="bi bi-person-circle"></i></div>
        <div class="user-meta">
            <div class="user-name" title="@context.User.Identity?.Name">@UserClaims.DisplayName(context.User)</div>
            <div class="user-role">@(context.User.IsInRole(FacebookPublisher.Application.Abstractions.AppRoles.Admin) ? "Administrator" : "User")</div>
        </div>
        <form method="post" action="@AccountEndpoints.LogoutPath" class="ms-auto">
            <AntiforgeryToken />
            <button type="submit" class="btn btn-sm btn-outline-light btn-icon" title="Sign out"><i class="bi bi-box-arrow-right"></i></button>
        </form>
    </div>
</AuthorizeView>

<div class="menu-footer">
    Posts are only made to groups your Facebook account already belongs to. The app stops whenever Facebook asks for verification.
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationState { get; set; }

    private bool _running;
    private Guid? _userId;

    protected override async Task OnInitializedAsync()
    {
        _userId = AuthenticationState is null ? null : UserClaims.GetUserId((await AuthenticationState).User);
        _running = _userId is { } id && Tracker.IsOwnerBusy(id);
        Broker.CampaignChanged += OnCampaignChanged;
    }

    private Task OnCampaignChanged(CampaignProgressDto campaign)
    {
        if (campaign.OwnerId != _userId)
        {
            return Task.CompletedTask; // another user's campaign
        }
        return InvokeAsync(() =>
        {
            _running = campaign.Status == CampaignStatus.Running || Tracker.IsOwnerBusy(campaign.OwnerId);
            StateHasChanged();
        });
    }

    public void Dispose() => Broker.CampaignChanged -= OnCampaignChanged;
}
