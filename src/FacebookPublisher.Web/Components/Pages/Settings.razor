@page "/settings"
@inherits AppComponentBase
@inject SettingsService SettingsService
@inject BrowserSessionService Session
@inject CampaignService CampaignService
@inject IJSRuntime JS

<PageTitle>Settings · Group Publisher</PageTitle>

<div class="page-header">
    <div>
        <h1>Settings</h1>
        <p>Your Facebook connection, publishing pace and browser configuration. These settings are yours only.</p>
    </div>
</div>

<AlertBox Errors="Errors" Success="@Success" />

@if (_model is null)
{
    <div class="empty-state"><i class="bi bi-hourglass-split"></i>Loading…</div>
}
else
{
    <div class="card-panel">
        <h2><i class="bi bi-facebook"></i> Facebook connection</h2>
        <div class="row g-3 align-items-center">
            <div class="col-lg-7">
                <p class="mb-2">
                    Your Facebook account is separate from your Group Publisher account. Group Publisher keeps a private browser
                    profile just for you: open the login window, sign in to Facebook yourself (including any 2-factor step),
                    then verify. Your password is never asked for or stored, and no other user can use your session.
                </p>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="text-muted">Status:</span>
                    @if (_model.SessionLastVerifiedResult is null)
                    {
                        <span class="status-badge s-neutral"><i class="bi bi-plug"></i> Not connected / not verified</span>
                    }
                    else if (_model.SessionLastVerifiedResult == true)
                    {
                        <span class="status-badge s-success"><i class="bi bi-check-circle"></i> Connected</span>
                    }
                    else
                    {
                        <span class="status-badge s-danger"><i class="bi bi-x-circle"></i> Not logged in</span>
                    }
                    @if (_model.SessionLastVerifiedAtUtc is not null)
                    {
                        <span class="text-muted small">verified @Fmt.Relative(_model.SessionLastVerifiedAtUtc)</span>
                    }
                    @if (_browserOpen)
                    {
                        <span class="status-badge s-info"><i class="bi bi-window"></i> Browser open</span>
                    }
                </div>
                @if (_sessionMessage is not null)
                {
                    <div class="small mt-2">@_sessionMessage</div>
                }
            </div>
            <div class="col-lg-5 d-flex flex-wrap gap-2 justify-content-lg-end">
                <button class="btn btn-primary" disabled="@(Busy || _campaignRunning)" @onclick="OpenLoginAsync"><i class="bi bi-box-arrow-in-right"></i> Open Facebook login</button>
                <button class="btn btn-outline-primary" disabled="@(Busy || _campaignRunning)" @onclick="VerifyAsync">
                    @if (_verifying)
                    {
                        <span><i class="bi bi-arrow-repeat spin"></i> Verifying…</span>
                    }
                    else
                    {
                        <span><i class="bi bi-shield-check"></i> Verify Facebook session</span>
                    }
                </button>
                <button class="btn btn-outline-secondary" disabled="@(Busy || _campaignRunning || !_browserOpen)" @onclick="CloseBrowserAsync"><i class="bi bi-x-square"></i> Close browser</button>
                <button class="btn btn-outline-danger" disabled="@(Busy || _campaignRunning)" @onclick="DisconnectAsync"><i class="bi bi-plug"></i> Disconnect Facebook</button>
            </div>
        </div>
        @if (_campaignRunning)
        {
            <div class="form-text text-warning mt-2"><i class="bi bi-info-circle"></i> Browser controls are disabled while one of your campaigns is running.</div>
        }
    </div>

    <EditForm Model="_model" OnValidSubmit="SaveAsync" FormName="settings">
        <DataAnnotationsValidator />
        <div class="card-panel">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                <div>
                    <h2 class="mb-1"><i class="bi bi-sliders"></i> Advanced Batch Processing &amp; Delay Settings</h2>
                    <div class="form-text mt-0">Defaults for new campaigns. Each campaign keeps its own copy, so changes here never affect a campaign that already exists.</div>
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ResetPacing"><i class="bi bi-arrow-counterclockwise"></i> Restore defaults</button>
            </div>
            <BatchPacingEditor @key="_pacingKey" Value="_model.Pacing" IdPrefix="settings-pacing" OnValidityChanged="v => _pacingValid = v" />
        </div>

        <div class="row g-3">
            <div class="col-lg-6">
                <div class="card-panel h-100">
                    <h2><i class="bi bi-speedometer"></i> Publishing</h2>

                    <div class="form-check form-switch mb-2">
                        <InputCheckbox class="form-check-input" id="approval" @bind-Value="_model.RequireApprovalByDefault" />
                        <label class="form-check-label" for="approval">Pause for approval before each post (off = fully automatic; default for new campaigns)</label>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Review timeout (minutes)</label>
                        <InputNumber class="form-control" @bind-Value="_model.ApprovalTimeoutMinutes" />
                        <ValidationMessage For="() => _model.ApprovalTimeoutMinutes" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Maximum groups per campaign</label>
                        <InputNumber class="form-control" @bind-Value="_model.MaxGroupsPerCampaign" />
                        <ValidationMessage For="() => _model.MaxGroupsPerCampaign" />
                    </div>
                    <div class="mb-1">
                        <label class="form-label">Duplicate protection window (hours)</label>
                        <InputNumber class="form-control" @bind-Value="_model.DuplicateWindowHours" />
                        <ValidationMessage For="() => _model.DuplicateWindowHours" />
                        <div class="form-text">Skip a group if the identical content was published there within this window. 0 disables the check.</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card-panel h-100">
                    <h2><i class="bi bi-browser-chrome"></i> Browser</h2>
                    <div class="mb-3">
                        <label class="form-label">Browser</label>
                        <InputSelect class="form-select" @bind-Value="_model.BrowserChannel">
                            @foreach (var (value, label) in SettingsService.BrowserChannels)
                            {
                                <option value="@value">@label</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="form-check form-switch mb-1">
                        <InputCheckbox class="form-check-input" id="headless" @bind-Value="_model.Headless" />
                        <label class="form-check-label" for="headless">Run hidden (headless) during campaigns</label>
                    </div>
                    <div class="form-text mb-3">Post review requires a visible window, and the login window is always visible.</div>
                    <div class="row g-2">
                        <div class="col">
                            <label class="form-label">Page load timeout (s)</label>
                            <InputNumber class="form-control" @bind-Value="_model.NavigationTimeoutSeconds" />
                            <ValidationMessage For="() => _model.NavigationTimeoutSeconds" />
                        </div>
                        <div class="col">
                            <label class="form-label">Upload timeout (s)</label>
                            <InputNumber class="form-control" @bind-Value="_model.UploadTimeoutSeconds" />
                            <ValidationMessage For="() => _model.UploadTimeoutSeconds" />
                        </div>
                    </div>
                    <div class="form-text">Browser changes apply the next time the browser starts (use "Close browser").</div>
                </div>
            </div>
        </div>
        <div class="mt-3">
            <button type="submit" class="btn btn-primary" disabled="@(Busy || !_pacingValid)"><i class="bi bi-save"></i> Save settings</button>
            @if (!_pacingValid)
            {
                <span class="validation-message ms-2">Fix the batch and delay settings above before saving.</span>
            }
        </div>
    </EditForm>
}

@code {
    private SettingsModel? _model;
    private string? _sessionMessage;
    private bool _verifying;
    private bool _pacingValid = true;
    private int _pacingKey;

    private void ResetPacing()
    {
        _model!.Pacing = new FacebookPublisher.Domain.Entities.BatchPacingConfig();
        _pacingValid = true;
        _pacingKey++;
    }

    private bool _campaignRunning;
    private bool _browserOpen;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() => await RunAsync(async () =>
    {
        _model = await SettingsService.GetAsync();
        await RefreshBrowserStateAsync();
    });

    private async Task RefreshBrowserStateAsync()
    {
        _campaignRunning = await CampaignService.HasRunningCampaignAsync();
        _browserOpen = await Session.IsBrowserOpenAsync();
    }

    private async Task SaveAsync()
    {
        if (_model is null)
        {
            return;
        }
        await RunAsync(() => SettingsService.SaveAsync(_model), "Settings saved.");
    }

    private async Task OpenLoginAsync()
    {
        await RunAsync(async () =>
        {
            await Session.OpenLoginWindowAsync();
            await RefreshBrowserStateAsync();
            _sessionMessage = "A Chrome window with your private profile has opened. Sign in to Facebook there, then click \"Verify Facebook session\".";
        });
    }

    private async Task VerifyAsync()
    {
        _verifying = true;
        await RunAsync(async () =>
        {
            var status = await Session.CheckSessionAsync();
            _sessionMessage = status.Message;
            var refreshed = await SettingsService.GetAsync();
            _model!.SessionLastVerifiedAtUtc = refreshed.SessionLastVerifiedAtUtc;
            _model.SessionLastVerifiedResult = refreshed.SessionLastVerifiedResult;
            await RefreshBrowserStateAsync();
        });
        _verifying = false;
    }

    private async Task CloseBrowserAsync()
    {
        await RunAsync(async () =>
        {
            await Session.CloseBrowserAsync();
            await RefreshBrowserStateAsync();
            _sessionMessage = "Browser closed. It will restart with the current settings when needed.";
        });
    }

    private async Task DisconnectAsync()
    {
        if (!await JS.InvokeAsync<bool>("confirm",
                "Disconnect Facebook? Your private browser profile (Facebook login, cookies and browser data) will be deleted. Campaigns cannot run until you log in to Facebook again."))
        {
            return;
        }
        await RunAsync(async () =>
        {
            await Session.DisconnectAsync();
            var refreshed = await SettingsService.GetAsync();
            _model!.SessionLastVerifiedAtUtc = refreshed.SessionLastVerifiedAtUtc;
            _model.SessionLastVerifiedResult = refreshed.SessionLastVerifiedResult;
            await RefreshBrowserStateAsync();
            _sessionMessage = "Facebook disconnected. Your browser profile was deleted.";
        });
    }
}
