@page "/campaigns/new"
@inherits AppComponentBase
@inject ContentService ContentService
@inject GroupService GroupService
@inject CampaignService CampaignService
@inject SettingsService SettingsService
@inject NavigationManager Nav
@inject FacebookPublisher.Application.Abstractions.ICampaignExecutionTracker Tracker

<PageTitle>Publishing Campaign · Group Publisher</PageTitle>

<div class="page-header">
    <div>
        <h1>Publishing Campaign</h1>
        <p>Choose content and groups, review the settings, then start. Membership is verified for every group before posting.</p>
    </div>
</div>

<AlertBox Errors="Errors" Success="@Success" />

@if (_settings is null)
{
    <div class="empty-state"><i class="bi bi-hourglass-split"></i>Loading…</div>
}
else
{
    @if (Tracker.ActiveCampaignId is not null)
    {
        <div class="info-banner"><i class="bi bi-info-circle me-1"></i> Another campaign is running. A new campaign will be queued and start when it finishes.</div>
    }

    <div class="row g-3">
        <div class="col-xl-7">
            <div class="card-panel">
                <h2><span class="badge text-bg-primary rounded-pill">1</span> Content</h2>
                @if (_contents.Count == 0)
                {
                    <div class="empty-state py-3"><i class="bi bi-collection"></i>No content yet. <a href="content">Create content first.</a></div>
                }
                else
                {
                    <select class="form-select" value="@_contentId" @onchange="OnContentChangedAsync">
                        <option value="">— Select content —</option>
                        @foreach (var c in _contents)
                        {
                            <option value="@c.Id">@c.Title (@Fmt.Time(c.CreatedAtUtc))</option>
                        }
                    </select>
                }
            </div>

            <div class="card-panel">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <h2 class="m-0"><span class="badge text-bg-primary rounded-pill">2</span> Groups <span class="text-muted fw-normal">(@_selected.Count selected, max @_settings.MaxGroupsPerCampaign)</span></h2>
                    <div class="d-flex gap-2">
                        <input class="form-control form-control-sm" style="max-width:200px" placeholder="Filter…" @bind="_filter" @bind:event="oninput" />
                        <button class="btn btn-sm btn-outline-secondary" @onclick="SelectAllVisible">Select all</button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => _selected.Clear()">None</button>
                    </div>
                </div>
                @if (_groups.Count == 0)
                {
                    <div class="empty-state py-3"><i class="bi bi-people"></i>No active groups. <a href="groups">Add groups first.</a></div>
                }
                else
                {
                    <div class="table-wrap" style="max-height:420px; overflow-y:auto">
                        <table class="table table-app table-hover">
                            <thead><tr><th style="width:2rem"></th><th>Group</th><th>Last known membership</th></tr></thead>
                            <tbody>
                                @foreach (var g in VisibleGroups)
                                {
                                    <tr @onclick="() => Toggle(g.Id)" style="cursor:pointer">
                                        <td><input type="checkbox" class="form-check-input" checked="@_selected.Contains(g.Id)" @onclick:stopPropagation="true" @onchange="() => Toggle(g.Id)" /></td>
                                        <td>
                                            <div class="fw-semibold">@g.Name</div>
                                            <div class="url-cell text-muted">@g.Url</div>
                                        </td>
                                        <td><StatusBadge Value="g.LastMembershipStatus" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (SelectedNonMembers > 0)
                    {
                        <div class="form-text text-warning"><i class="bi bi-exclamation-triangle"></i> @SelectedNonMembers selected group(s) were last seen as "Not a Member" or "Inaccessible"; they will be re-checked and skipped if still not accessible.</div>
                    }
                }
            </div>
        </div>

        <div class="col-xl-5">
            <div class="card-panel">
                <h2><span class="badge text-bg-primary rounded-pill">3</span> Settings</h2>
                <div class="mb-3">
                    <label class="form-label">Campaign name</label>
                    <input class="form-control" @bind="_name" maxlength="200" />
                </div>
                <div class="form-check form-switch mb-1">
                    <input class="form-check-input" type="checkbox" id="approval" @bind="_requireApproval" />
                    <label class="form-check-label" for="approval">Pause for my approval before each post (optional)</label>
                </div>
                <div class="form-text mb-3">
                    @if (_requireApproval)
                    {
                        <span>Each post is prepared in the browser window and waits for your Approve/Reject in the Execution Monitor (timeout @_settings.ApprovalTimeoutMinutes min).</span>
                    }
                    else
                    {
                        <span>Fully automatic: posts are published without waiting for you. Every step is shown live in the Execution Monitor.</span>
                    }
                </div>

                <dl class="kv mb-3">
                    <dt>Groups</dt><dd>@_selected.Count</dd>
                    <dt>Estimated batches</dt><dd>@(_selected.Count == 0 ? "—" : $"≈ {Math.Ceiling(_selected.Count / PacingEstimator.AverageBatchSize(_pacing))}")</dd>
                    <dt>Estimated duration</dt><dd>@EstimatedDuration</dd>
                    <dt>Duplicate protection</dt><dd>@(_settings.DuplicateWindowHours > 0 ? $"skip groups that received this content in the last {_settings.DuplicateWindowHours} h" : "off")</dd>
                </dl>

                @if (!_pacingValid)
                {
                    <div class="validation-message mb-2">Fix the batch and delay settings below before starting.</div>
                }
                <div class="d-flex gap-2">
                    <button class="btn btn-primary flex-grow-1" disabled="@(!CanSubmit)" @onclick="() => CreateAsync(start: true)">
                        @if (Busy && _starting)
                        {
                            <span><i class="bi bi-arrow-repeat spin"></i> Starting…</span>
                        }
                        else
                        {
                            <span><i class="bi bi-play-fill"></i> Start campaign</span>
                        }
                    </button>
                    <button class="btn btn-outline-secondary" disabled="@(!CanSubmit)" title="Create the campaign now and start it later from the Execution Monitor"
                            @onclick="() => CreateAsync(start: false)">
                        <i class="bi bi-save"></i> Save without starting
                    </button>
                </div>
            </div>

            <div class="card-panel">
                <h2><i class="bi bi-eye"></i> Content preview</h2>
                @if (_content is null)
                {
                    <div class="empty-state py-3">Select content to preview it.</div>
                }
                else
                {
                    <ContentPreview Content="_content" />
                }
            </div>
        </div>
    </div>

    <div class="card-panel">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
            <div>
                <h2 class="mb-1"><span class="badge text-bg-primary rounded-pill">4</span> Advanced Batch Processing &amp; Delay Settings</h2>
                <div class="form-text mt-0">Prefilled from Settings. These values are saved with this campaign and used for its whole run, including every Resume.</div>
            </div>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ResetPacing"><i class="bi bi-arrow-counterclockwise"></i> Use defaults from Settings</button>
        </div>
        <BatchPacingEditor @key="_pacingKey" Value="_pacing" IdPrefix="campaign-pacing" OnValidityChanged="v => _pacingValid = v" />
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "contentId")]
    public Guid? InitialContentId { get; set; }

    private FacebookPublisher.Domain.Entities.PublisherSettings? _settings;
    private List<ContentSummaryDto> _contents = [];
    private List<GroupDto> _groups = [];
    private readonly HashSet<Guid> _selected = [];
    private Guid? _contentId;
    private ContentDetailDto? _content;
    private string _filter = string.Empty;
    private string _name = $"Campaign {DateTime.Now:dd MMM yyyy HH:mm}";
    private BatchPacingConfig _pacing = new();
    private bool _pacingValid = true;
    private int _pacingKey;
    private bool _requireApproval;
    private bool _starting;

    private bool CanSubmit => !Busy && _contentId is not null && _selected.Count > 0 && _pacingValid;

    private IEnumerable<GroupDto> VisibleGroups => string.IsNullOrWhiteSpace(_filter)
        ? _groups
        : _groups.Where(g => g.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase) || g.Url.Contains(_filter, StringComparison.OrdinalIgnoreCase));

    private int SelectedNonMembers => _groups.Count(g => _selected.Contains(g.Id)
        && g.LastMembershipStatus is MembershipStatus.NotMember or MembershipStatus.Inaccessible);

    private string EstimatedDuration
    {
        get
        {
            if (_selected.Count == 0 || !_pacingValid)
            {
                return "—";
            }
            // Midpoints of each range: ~30 s of browser work per group plus post, batch and extended delays.
            var span = PacingEstimator.EstimateDuration(_selected.Count, _pacing);
            return "≈ " + DurationText.Format(span) + (_requireApproval ? " + review time" : "");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await RunAsync(async () =>
        {
            _settings = await SettingsService.GetEntityAsync();
            _pacing = _settings.Pacing.Clone();
            _requireApproval = _settings.RequireApprovalByDefault;
            _contents = (await ContentService.ListAsync()).ToList();
            _groups = (await GroupService.ListAsync(activeOnly: true)).ToList();

            if (InitialContentId is { } id && _contents.Any(c => c.Id == id))
            {
                await SelectContentAsync(id);
            }
        });
    }

    private async Task OnContentChangedAsync(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id))
        {
            await RunAsync(() => SelectContentAsync(id));
        }
        else
        {
            _contentId = null;
            _content = null;
        }
    }

    private async Task SelectContentAsync(Guid id)
    {
        _contentId = id;
        _content = await ContentService.GetAsync(id);
    }

    private void Toggle(Guid id)
    {
        if (!_selected.Remove(id))
        {
            _selected.Add(id);
        }
    }

    private void SelectAllVisible()
    {
        foreach (var g in VisibleGroups)
        {
            if (_selected.Count >= _settings!.MaxGroupsPerCampaign)
            {
                break;
            }
            _selected.Add(g.Id);
        }
    }

    private void ResetPacing()
    {
        _pacing = _settings!.Pacing.Clone();
        _pacingValid = true;
        _pacingKey++;
    }

    private async Task CreateAsync(bool start)
    {
        Guid campaignId = default;
        _starting = start;
        // Keep the original group order from the table.
        var orderedIds = _groups.Where(g => _selected.Contains(g.Id)).Select(g => g.Id).ToList();
        if (await RunAsync(async () => campaignId = await CampaignService.CreateAsync(
                new CreateCampaignRequest(_name, _contentId!.Value, orderedIds, _pacing.Clone(), _requireApproval), start)))
        {
            Nav.NavigateTo($"monitor/{campaignId}");
        }
        _starting = false;
    }
}
