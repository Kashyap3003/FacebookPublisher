{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=FacebookPublisher;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=False"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/facebook-publisher-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Hosting": {
    "AutomationEnabled": true,
    "RequireLogin": false,
    "LoginUsername": "",
    "LoginPassword": ""
  },
  "Storage": {
    "RootPath": "App_Data/uploads"
  },
  "ContentUpload": {
    "MaxImageBytes": 10485760,
    "MaxVideoBytes": 536870912,
    "MaxPdfBytes": 52428800,
    "MaxAttachments": 10,
    "MaxTextLength": 20000
  },
  "FacebookAutomation": {
    "PageProbeSeconds": 20,
    "ComposerOpenSeconds": 20,
    "PostConfirmSeconds": 90
  },
  "AllowedHosts": "*"
}
